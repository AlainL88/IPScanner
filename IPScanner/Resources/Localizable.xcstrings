    "On iOS, background scans are best-effort and may be delayed by the system.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS, background scans are best-effort and may be delayed by the system."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iOS le scansioni in background sono basate sul best-effort e potrebbero subire ritardi dal sistema."
          }
        }
      }
    },
    "On iOS, the system does not expose the MAC addresses of nearby devices (the ARP table is restricted). This information is available on macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS, the system does not expose the MAC addresses of nearby devices (the ARP table is restricted). This information is available on macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iOS il sistema non espone gli indirizzi MAC dei dispositivi vicini (la tabella ARP è limitata). Questa informazione è disponibile su macOS."
          }
        }
      }
    },
